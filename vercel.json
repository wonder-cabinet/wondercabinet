{
  "buildCommand": "",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/renew-watch",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/events/:slug",
      "destination": "/event.html?id=:slug"
    },
    {
      "source": "/artists/:slug",
      "destination": "/artist.html?id=:slug"
    },
    {
      "source": "/projects/:slug",
      "destination": "/project.html?id=:slug"
    }
  ]
}