<!-- React + Babel for tweaks panel -->
<script src="https://unpkg.com/react@18.3.1/umd/react.development.js" integrity="sha384-hD6/rw4ppMLGNu3tX5cjIb+uRZ7UkRJ6BPkLpg4hAu/6onKUg4lLsHAs9EBPT82L" crossorigin="anonymous"></script>
<script src="https://unpkg.com/react-dom@18.3.1/umd/react-dom.development.js" integrity="sha384-u6aeetuaXnQ38mYT8rp6sbXaQe3NL9t+IBXmnYxwkUI2Hw4bsp2Wvmx4yRQF1uAm" crossorigin="anonymous"></script>
<script src="https://unpkg.com/@babel/standalone@7.29.0/babel.min.js" integrity="sha384-m08KidiNqLdpJqLq95G/LEi8Qvjl/xUYll3QILypMoQ65QorJ9Lvtp2RXYGBFj1y" crossorigin="anonymous"></script>
<script type="text/babel" src="assets/tweaks-panel.jsx" data-plugins="transform-react-jsx-source,om-src-id" data-filename="assets/tweaks-panel.jsx"></script>
<div id="tweaks-root"></div>
<script type="text/babel" data-plugins="transform-react-jsx-source,om-src-id" data-filename="inline-1">
const TWEAK_DEFAULTS = /*EDITMODE-BEGIN*/{
  "bg": "#00d26a",
  "ink": "#1d24ff",
  "highlight": "#ffe65c",
  "preset": "paper-blue",
  "heroScale": 1.4,
  "density": "compact",
  "showRecurringStrip": true,
  "defaultView": "list"
}/*EDITMODE-END*/;

const PRESETS = {
  "green-blue": { bg: "#00d26a", ink: "#1d24ff", highlight: "#ffe65c", paper: "#f6f3ea" },
  "paper-blue": { bg: "#f6f3ea", ink: "#1d24ff", highlight: "#ffe65c", paper: "#f6f3ea" },
  "paper-ink":  { bg: "#f6f3ea", ink: "#0a0a16", highlight: "#ff3b1d", paper: "#f6f3ea" },
  "blue-paper": { bg: "#1d24ff", ink: "#f6f3ea", highlight: "#ffe65c", paper: "#1d24ff" },
  "orange-ink": { bg: "#ffd6c2", ink: "#0a0a16", highlight: "#ff3b1d", paper: "#ffd6c2" }
};

function App(){
  const [t, setTweak] = useTweaks(TWEAK_DEFAULTS);

  // Apply theme vars
  React.useEffect(() => {
    const r = document.documentElement.style;
    const preset = PRESETS[t.preset] || PRESETS["green-blue"];
    const bg = t.preset === "custom" ? t.bg : preset.bg;
    const ink = t.preset === "custom" ? t.ink : preset.ink;
    const hl = t.preset === "custom" ? t.highlight : preset.highlight;
    r.setProperty("--bg", bg);
    r.setProperty("--ink", ink);
    r.setProperty("--highlight", hl);
    r.setProperty("--paper", preset.paper || bg);
    r.setProperty("--card", bg);
    r.setProperty("--rule", ink);
    r.setProperty("--rule-strong", ink);
  }, [t.preset, t.bg, t.ink, t.highlight]);

  // Hero scale
  React.useEffect(() => {
    const h1 = document.querySelector(".hero h1");
    if (h1) h1.style.fontSize = `clamp(${48*t.heroScale}px, ${12*t.heroScale}vw, ${200*t.heroScale}px)`;
  }, [t.heroScale]);

  // Density (target schedule rows now)
  React.useEffect(() => {
    const map = { compact: "10px", regular: "16px", comfy: "24px" };
    document.querySelectorAll(".schedule-row").forEach(el => {
      el.style.paddingTop = map[t.density];
      el.style.paddingBottom = map[t.density];
    });
  }, [t.density]);

  // Recurring strip (removed feature — keep no-op for back-compat)
  React.useEffect(() => {
    const s = document.querySelector(".recurring-strip");
    if (s) s.style.display = "none";
  }, [t.showRecurringStrip]);

  // Default view
  React.useEffect(() => {
    if (t.defaultView && document.body.getAttribute("data-view-locked") !== "true"){
      document.body.setAttribute("data-view", t.defaultView);
      document.querySelectorAll("[data-view-btn]").forEach(b => b.setAttribute("aria-pressed", String(b.dataset.viewBtn === t.defaultView)));
    }
  }, [t.defaultView]);

  return (
    <TweaksPanel>
      <TweakSection label="Theme" />
      <TweakSelect label="Palette" value={t.preset}
        options={[
          {value:"green-blue", label:"Green + Blue (default)"},
          {value:"paper-blue", label:"Paper + Blue"},
          {value:"paper-ink",  label:"Paper + Ink"},
          {value:"blue-paper", label:"Blue + Paper (inverted)"},
          {value:"orange-ink", label:"Apricot + Ink"},
          {value:"custom",     label:"Custom…"}
        ]}
        onChange={(v) => setTweak('preset', v)} />
      {t.preset === "custom" && (<>
        <TweakColor label="Background" value={t.bg}        onChange={(v) => setTweak('bg', v)} />
        <TweakColor label="Ink"        value={t.ink}       onChange={(v) => setTweak('ink', v)} />
        <TweakColor label="Highlight"  value={t.highlight} onChange={(v) => setTweak('highlight', v)} />
      </>)}

      <TweakSection label="Layout" />
      <TweakSlider label="Hero scale" value={t.heroScale} min={0.6} max={1.4} step={0.05}
        onChange={(v) => setTweak('heroScale', v)} />
      <TweakRadio  label="Event density" value={t.density}
        options={['compact','regular','comfy']}
        onChange={(v) => setTweak('density', v)} />

      <TweakSection label="Default view" />
      <TweakRadio label="Open in" value={t.defaultView}
        options={['list','calendar','archive']}
        onChange={(v) => setTweak('defaultView', v)} />
    </TweaksPanel>
  );
}

ReactDOM.createRoot(document.getElementById("tweaks-root")).render(<App/>);
</script>
<script>
/* ============================================================
   STATE
   ============================================================ */
const STATE = {
  view: "list",
  type: "",
  when: "",
  sort: "date"
};

const UPCOMING = window.EVENTS.filter(e => e.status === "upcoming");
const PAST     = window.EVENTS.filter(e => e.status === "past");

/* ============================================================
   WEEK STRIP
   ============================================================ */
(function(){
  const weekDays = [
    { day: "06", dow: "Mon", dowAr: "الاثنين" },
    { day: "07", dow: "Tue", dowAr: "الثلاثاء" },
    { day: "08", dow: "Wed", dowAr: "الأربعاء" },
    { day: "09", dow: "Thu", dowAr: "الخميس" },
    { day: "10", dow: "Fri", dowAr: "الجمعة" },
    { day: "11", dow: "Sat", dowAr: "السبت" },
    { day: "12", dow: "Sun", dowAr: "الأحد" }
  ];
  const today = "08";
  const track = document.getElementById("week-scroll");
  const html = weekDays.map(d => {
    const ev = UPCOMING.find(e => e.month === "Nov" && e.day === d.day);
    const isToday = d.day === today;
    if (ev) {
      const locAr = ({"Ground floor":"الطابق الأرضي","Screening room":"غرفة العرض","Main hall":"القاعة الرئيسية","Library":"المكتبة","Studio":"الستوديو","Workshop":"الورشة","Whole building":"كامل المبنى"})[ev.location] || ev.location || "";
      const typeAr = ({Class:"صف",Film:"فيلم",Performance:"عرض",Radio:"إذاعة",Reading:"قراءة",Workshop:"ورشة",Opening:"افتتاح"})[ev.type] || ev.type;
      return `
        <a class="week-card ${isToday ? "today" : ""}" href="event.html?id=${ev.id}">
          <div class="wc-date-row">
            <div class="wc-day">${ev.day}</div>
            <div class="wc-dow"><span class="en-only">${ev.dow}</span><span class="ar-only ar">${ev.dowAr}</span></div>
          </div>
          <div class="wc-type"><span class="en-only">${ev.type} · ${ev.start}${ev.recurring ? " · ↻" : ""}</span><span class="ar-only ar">${typeAr} · ${ev.start}${ev.recurring ? " · ↻" : ""}</span></div>
          <h3 class="wc-title"><span class="en-only">${ev.title}</span><span class="ar-only ar" dir="rtl">${ev.titleAr || ev.title}</span></h3>
          <div class="wc-meta">
            <span><span class="en-only">${ev.location || ""}</span><span class="ar-only ar">${locAr}</span></span>
            <span class="arrow">→</span>
          </div>
        </a>`;
    } else {
      return `
        <div class="week-card empty">
          <div class="wc-date-row">
            <div class="wc-day">${d.day}</div>
            <div class="wc-dow"><span class="en-only">${d.dow}</span><span class="ar-only ar">${d.dowAr}</span></div>
          </div>
          <div class="wc-title wc-empty-mark">—</div>
          <div class="wc-meta"><span><span class="en-only">Rest day</span><span class="ar-only ar">يوم راحة</span></span><span></span></div>
        </div>`;
    }
  }).join("");
  track.innerHTML = html;
  const todayCard = track.querySelector(".week-card.today");
  if (todayCard) track.scrollLeft = todayCard.offsetLeft - track.offsetLeft - 20;
  const step = 300;
  document.getElementById("week-prev").onclick = () => track.scrollBy({left:-step, behavior:"smooth"});
  document.getElementById("week-next").onclick = () => track.scrollBy({left:step, behavior:"smooth"});
})();

/* ============================================================
   RECURRING STRIP — (removed)
   Now inlined into week + month lists with ↻ marker.
   ============================================================ */

/* ============================================================
   MONTH LISTS (filtered, no recurring duplicates)
   ============================================================ */
function applyFilters(arr){
  let out = arr.slice();
  if (STATE.type) out = out.filter(e => e.type === STATE.type);
  if (STATE.when === "this-week") out = out.filter(e => e.month === "Nov" && parseInt(e.day) >= 6 && parseInt(e.day) <= 12);
  if (STATE.when === "this-month") out = out.filter(e => e.month === "Nov");
  if (STATE.when === "next-month") out = out.filter(e => e.month === "Dec");
  if (STATE.sort === "az") out.sort((a,b) => a.title.localeCompare(b.title));
  return out;
}

function renderMonths(){
  // Include recurring events inline (marked with ↻)
  const filtered = applyFilters(UPCOMING);
  const byMonth = {};
  filtered.forEach(e => { (byMonth[e.month] = byMonth[e.month] || []).push(e); });

  ["Nov","Dec"].forEach(month => {
    const list = document.querySelector(`.month-list[data-month="${month}"]`);
    const events = byMonth[month] || [];
    if (!list) return;
    if (!events.length){
      list.innerHTML = `<div class="schedule-empty"><span class="en-only">No events match these filters.</span><span class="ar-only ar" dir="rtl">لا توجد فعاليات تطابق التصفية.</span></div>`;
      const elc = document.getElementById(`count-${month}`);
      if (elc) elc.textContent = `00 events`;
      return;
    }
    // Group by day, sort each day by start time
    const byDay = {};
    events.forEach(e => { (byDay[e.day] = byDay[e.day] || { day: e.day, dow: e.dow, dowAr: e.dowAr, evs: [] }).evs.push(e); });
    const days = Object.values(byDay)
      .sort((a,b) => a.day.localeCompare(b.day))
      .map(d => ({ ...d, evs: d.evs.slice().sort((a,b) => (a.start||"").localeCompare(b.start||"")) }));

    list.innerHTML = `
      <div class="schedule" role="table">
        <div class="schedule-headrow" role="row">
          <div class="sh-date"><span class="en-only">Date</span><span class="ar-only ar">التاريخ</span></div>
          <div class="sh-time"><span class="en-only">Time</span><span class="ar-only ar">الوقت</span></div>
          <div class="sh-venue"><span class="en-only">Venue</span><span class="ar-only ar">المكان</span></div>
          <div class="sh-title"><span class="en-only">Programme</span><span class="ar-only ar">الفعالية</span></div>
          <div class="sh-tag"></div>
        </div>
        ${days.map(d => d.evs.map((e, i) => {
          const venueParts = (e.location || "").split("·").map(s => s.trim()).filter(Boolean);
          const venue = venueParts[0] || e.location || "";
          const floor = venueParts[1] || "";
          const venueArMap = { "Ground floor":"الطابق الأرضي","Screening room":"غرفة العرض","Main hall":"القاعة الرئيسية","Library":"المكتبة","Studio":"الستوديو","Workshop":"الورشة","Whole building":"كامل المبنى","Bar open":"البار مفتوح" };
          const venueAr = venueArMap[venue] || venue;
          const floorAr = venueArMap[floor] || floor;
          const typeAr = { Class: "صف", Film: "فيلم", Performance: "عرض", Radio: "إذاعة", Reading: "قراءة", Workshop: "ورشة", Opening: "افتتاح" }[e.type] || e.type;
          const tag = e.featured ? `<span class="sch-tag sch-featured"><span class="en-only">Featured</span><span class="ar-only ar">مميّز</span></span>`
                    : e.recurring ? `<span class="sch-tag sch-recurring"><span class="en-only">↻ Weekly</span><span class="ar-only ar">↻ أسبوعي</span></span>`
                    : (e.register ? `<span class="sch-tag sch-rsvp"><span class="en-only">Register</span><span class="ar-only ar">تسجيل</span></span>` : `<span class="sch-tag sch-free"><span class="en-only">Free entry</span><span class="ar-only ar">دخول حرّ</span></span>`);
          const isFirst = i === 0;
          return `
            <a class="schedule-row${isFirst ? ' sch-first' : ''}" href="event.html?id=${e.id}" role="row">
              <div class="sch-date">
                ${isFirst ? `
                  <span class="sch-day">${d.day}</span>
                  <span class="sch-dow"><span class="en-only">${d.dow}</span><span class="ar-only ar">${d.dowAr}</span></span>
                ` : ''}
              </div>
              <div class="sch-time">
                <span class="sch-start">${e.start || ""}</span>
                ${e.end ? `<span class="sch-end">${e.end}</span>` : ''}
              </div>
              <div class="sch-venue">
                <span class="sch-venue-name"><span class="en-only">${venue}</span><span class="ar-only ar">${venueAr}</span></span>
                ${floor ? `<span class="sch-venue-sub"><span class="en-only">${floor}</span><span class="ar-only ar">${floorAr}</span></span>` : ''}
              </div>
              <div class="sch-title">
                <span class="sch-type"><span class="en-only">${e.type}</span><span class="ar-only ar">${typeAr}</span></span>
                <span class="sch-name">
                  <span class="en-only">${e.title}${e.recurring ? ' <span class="sch-recur-mark">↻</span>' : ''}</span>
                  <span class="ar-only ar" dir="rtl">${e.titleAr || e.title}${e.recurring ? ' <span class="sch-recur-mark">↻</span>' : ''}</span>
                </span>
              </div>
              <div class="sch-tag-cell">${tag}</div>
            </a>`;
        }).join('')).join('')}
      </div>`;
    const n = events.length.toString().padStart(2,"0");
    const arN = n.replace(/[0-9]/g, d => "٠١٢٣٤٥٦٧٨٩"[d]);
    const el = document.getElementById(`count-${month}`);
    if (el) el.innerHTML = `<span class="en-only">${n} ${events.length===1?"event":"events"}</span><span class="ar-only ar">${arN} فعاليات</span>`;
  });
}
renderMonths();

/* ============================================================
   CALENDAR VIEW
   ============================================================ */
function renderCalendar(){
  const months = [
    { key: "Nov", name: "November", ar: "نوفمبر", days: 30, firstDow: 6 }, // Nov 1, 2025 = Saturday
    { key: "Dec", name: "December", ar: "ديسمبر", days: 31, firstDow: 1 }  // Dec 1, 2025 = Monday
  ];
  const dows = ["Mon","Tue","Wed","Thu","Fri","Sat","Sun"];
  // Map firstDow from Sunday-based JS index to Monday-based grid
  const today = { month: "Nov", day: "08" };

  const html = months.map(m => {
    // Convert firstDow: Sun=0 -> 6, Mon=1 -> 0, etc.
    const startCol = (m.firstDow + 6) % 7;
    const filtered = applyFilters(UPCOMING).filter(e => e.month === m.key);

    let cells = "";
    for (let i = 0; i < startCol; i++) cells += `<div class="cal-cell empty"></div>`;
    for (let d = 1; d <= m.days; d++){
      const ds = String(d).padStart(2,"0");
      const evs = filtered.filter(e => e.day === ds);
      const isToday = m.key === today.month && ds === today.day;
      cells += `
        <div class="cal-cell">
          <span class="cal-num ${isToday ? "is-today" : ""}">${d}</span>
          ${evs.map(e => `
            <a class="cal-event ${e.featured ? "featured" : ""} ${e.recurring ? "recurring" : ""}" href="event.html?id=${e.id}">
              <span class="e-time">${e.start} · ${e.type}</span>
              ${e.title.length > 28 ? e.title.slice(0,28)+"…" : e.title}
            </a>
          `).join("")}
        </div>`;
    }
    return `
      <div class="cal-month">
        <div class="cal-month-head">
          <h2>${m.name}</h2>
          <div></div>
          <div class="ar" dir="rtl">${m.ar}</div>
        </div>
        <div class="cal-grid">
          ${dows.map(d => `<div class="cal-dow">${d}</div>`).join("")}
          ${cells}
        </div>
      </div>`;
  }).join("");
  document.getElementById("cal-wrap").innerHTML = html;
}
renderCalendar();

/* ============================================================
   ARCHIVE VIEW
   ============================================================ */
function renderArchive(){
  const monthNames = { Oct: "October", Mar: "March", May: "May", Jul: "July" };
  const sorted = PAST.slice().sort((a,b) => {
    const aa = a.year * 100 + ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"].indexOf(a.month);
    const bb = b.year * 100 + ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"].indexOf(b.month);
    return bb - aa;
  });
  const html = sorted.map(e => `
    <a class="archive-entry" href="event.html?id=${e.id}">
      <div class="ae-cover"><img src="${e.cover}" alt="" loading="lazy"/></div>
      <div>
        <div class="archive-meta-row">
          <span class="type">${e.type}</span>
          <span>${e.day} ${monthNames[e.month] || e.month} ${e.year}</span>
          <span>${e.location}</span>
        </div>
        <h3 class="ae-title">${e.title}</h3>
        <div class="ae-title-ar ar" dir="rtl">${e.titleAr}</div>
        <p class="ae-writeup en-only">${e.writeup}</p>
        <p class="ae-writeup-ar ar-only ar" dir="rtl">${e.writeupAr}</p>
        <span class="ae-readmore">
          <span class="en-only">Read full account</span>
          <span class="ar-only ar" dir="rtl">القراءة كاملةً</span>
          <span class="ae-readmore-arrow">→</span>
        </span>
      </div>
    </a>
  `).join("");
  document.getElementById("archive-list").innerHTML = html;
}
renderArchive();

/* ============================================================
   VIEW SWITCH + FILTERS
   ============================================================ */
function setView(v){
  STATE.view = v;
  document.body.setAttribute("data-view", v);
  document.querySelectorAll("[data-view-btn]").forEach(b => {
    b.setAttribute("aria-pressed", String(b.dataset.viewBtn === v));
  });
  try { localStorage.setItem("twc-view", v); } catch(e){}
}
document.querySelectorAll("[data-view-btn]").forEach(btn => {
  btn.addEventListener("click", () => { document.body.setAttribute("data-view-locked","true"); setView(btn.dataset.viewBtn); });
});
try {
  const saved = localStorage.getItem("twc-view");
  if (saved && ["list","calendar","archive"].includes(saved)) setView(saved);
} catch(e){}

document.getElementById("f-type").addEventListener("change", e => { STATE.type = e.target.value; renderMonths(); renderCalendar(); });
document.getElementById("f-when").addEventListener("change", e => { STATE.when = e.target.value; renderMonths(); renderCalendar(); });
document.getElementById("f-sort").addEventListener("change", e => { STATE.sort = e.target.value; renderMonths(); });

/* ============================================================
   LANGUAGE TOGGLE
   ============================================================ */
function applyLangToOptions(lang){
  document.querySelectorAll("option[data-en][data-ar]").forEach(o => {
    o.textContent = lang === "ar" ? o.dataset.ar : o.dataset.en;
  });
}
document.querySelectorAll("[data-lang-btn]").forEach(btn => {
  btn.addEventListener("click", () => {
    document.querySelectorAll("[data-lang-btn]").forEach(b => b.setAttribute("aria-pressed","false"));
    btn.setAttribute("aria-pressed","true");
    document.documentElement.setAttribute("data-lang", btn.dataset.langBtn);
    applyLangToOptions(btn.dataset.langBtn);
    try { localStorage.setItem("twc-lang", btn.dataset.langBtn); } catch(e){}
  });
});
try {
  const saved = localStorage.getItem("twc-lang");
  if (saved && (saved === "en" || saved === "ar")) {
    document.documentElement.setAttribute("data-lang", saved);
    document.querySelectorAll("[data-lang-btn]").forEach(b => b.setAttribute("aria-pressed", String(b.dataset.langBtn===saved)));
    applyLangToOptions(saved);
  } else {
    applyLangToOptions(document.documentElement.getAttribute("data-lang") || "en");
  }
} catch(e){
  applyLangToOptions("en");
}
</script>


</body></html>