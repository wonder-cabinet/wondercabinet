<!DOCTYPE html><html lang="en" data-lang="en" style="--bg: #f6f3ea; --ink: #1d24ff; --highlight: #ffe65c; --paper: #f6f3ea; --card: #f6f3ea; --rule: #1d24ff; --rule-strong: #1d24ff;"><head>


<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Programme · The Wonder Cabinet</title>
<link rel="stylesheet" href="assets/app.css?v=5">
</head>
<body data-view="list">

<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="index.html">
      <span class="en-only">The Wonder Cabinet</span>
      <span class="ar-only ar" dir="rtl">مجلس العجب</span>
    </a>
    <div class="topbar-center"></div>
    <nav class="topbar-right">
      <a href="#programme"><span class="en-only">Programme</span><span class="ar-only ar">البرنامج</span></a>
      <a href="#archive"><span class="en-only">Archive</span><span class="ar-only ar">الأرشيف</span></a>
      <a href="#visit"><span class="en-only">Visit</span><span class="ar-only ar">زيارة</span></a>
      <div class="lang-toggle" role="group" aria-label="Language">
        <button data-lang-btn="en" aria-pressed="true">EN</button>
        <button data-lang-btn="ar" aria-pressed="false">AR</button>
      </div>
    </nav>
  </div>
</header>

<section class="hero">
  <div class="kicker">
    <span class="en-only">Programme · Autumn 2025</span>
    <span class="ar-only ar">البرنامج · خريف ٢٠٢٥</span>
    <span class="rule"></span>
    <span class="en-only">Films · Performances · Radio · Practices · Writing</span>
    <span class="ar-only ar">أفلام · عروض · إذاعة · ممارسات · كتابة</span>
  </div>
  <h1 style="font-size: clamp(67.2px, 16.8vw, 280px);"><span class="en-only">Programme</span><span class="ar-only ar" dir="rtl">برنامج</span></h1>
  <div class="hero-sub">
    <p class="en-only" style="font-size: 38px; line-height: 1.25; font-weight: 600; width: 800px">Films, performances, radio sessions and ongoing practices at the Cabinet — alongside what we have already done, and what we have written about it. The events page is also our blog and our archive.</p>
    <p class="ar-only ar" dir="rtl">أفلام، عروض، جلسات إذاعية وممارسات مستمرّة في مجلس العجب — إلى جانب ما قمنا به سابقاً وما كتبناه عنه. صفحة الفعاليات هي أيضاً مدوّنتنا وأرشيفنا.</p>
  </div>
</section>

<!-- TOOLBAR: filters + view switcher -->
<div class="toolbar">
  <div class="filter-bar" id="filter-bar">
    <span class="toolbar-label en-only">Filter:</span>
    <span class="toolbar-label ar-only ar" dir="rtl">تصفية:</span>
    <select id="f-type" data-i18n="type">
      <option value="" data-en="Everything" data-ar="الكل">Everything</option>
      <option value="Film" data-en="Film" data-ar="فيلم">Film</option>
      <option value="Performance" data-en="Performance" data-ar="عرض">Performance</option>
      <option value="Radio" data-en="Radio" data-ar="إذاعة">Radio</option>
      <option value="Class" data-en="Class" data-ar="صف">Class</option>
      <option value="Reading" data-en="Reading" data-ar="قراءة">Reading</option>
      <option value="Workshop" data-en="Workshop" data-ar="ورشة">Workshop</option>
      <option value="Opening" data-en="Opening" data-ar="افتتاح">Opening</option>
    </select>
    <select id="f-when">
      <option value="" data-en="Anytime" data-ar="في أي وقت">Anytime</option>
      <option value="this-week" data-en="This week" data-ar="هذا الأسبوع">This week</option>
      <option value="this-month" data-en="This month" data-ar="هذا الشهر">This month</option>
      <option value="next-month" data-en="Next month" data-ar="الشهر القادم">Next month</option>
    </select>
    <select id="f-sort">
      <option value="date" data-en="Sort: Date" data-ar="ترتيب: التاريخ">Sort: Date</option>
      <option value="az" data-en="Sort: A–Z" data-ar="ترتيب: أبجدي">Sort: A–Z</option>
    </select>
  </div>
  <div class="view-switch" role="group" aria-label="View">
    <button data-view-btn="list" aria-pressed="true"><span class="en-only">List</span><span class="ar-only ar">قائمة</span></button>
    <button data-view-btn="calendar" aria-pressed="false" style="margin: 1px;"><span class="en-only">Calendar</span><span class="ar-only ar">تقويم</span></button>
    <button data-view-btn="archive" aria-pressed="false"><span class="en-only">Archive</span><span class="ar-only ar">أرشيف</span></button>
  </div>
</div>

<!-- THIS WEEK (horizontal) — visible in list view only -->
<section class="week" id="programme">
  <div class="week-head">
    <h2><span class="en-only">This week · <em>06 — 12 November</em></span><span class="ar-only ar" dir="rtl">هذا الأسبوع · ٠٦ — ١٢ نوفمبر</span></h2>
    <div class="week-nav">
      <button id="week-prev" aria-label="Previous week">← Prev</button>
      <button id="week-next" aria-label="Next week">Next →</button>
    </div>
  </div>
  <div class="week-scroll" id="week-scroll">
        <a class="week-card " href="event.html?id=yoga-nov-06">
